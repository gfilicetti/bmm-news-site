# Google Cloud Vertex AI Settings (Application Default Credentials)
project: "your-gcp-project-id"   # Replace with your GCP Project ID
location: "us-central1"          # Google Cloud Region

# Model Settings
model: "veo-3.1-lite-generate-001"

# Video & Audio Generation Parameters
generate_audio: true             # Enable audio and voiceover generation (true/false)
aspect_ratio: "16:9"             # Options: "16:9", "9:16", "1:1", "4:3"
duration_seconds: 8              # Video duration in seconds (5 to 8)
fps: 24                           # Frames per second
person_generation: "allow_adult" # Options: "allow_adult", "dont_allow"

# File & Directory Settings
prompts_dir: "scripts/prompts"
output_dir: "scripts/output"
output_prefix: "generated_video_"
